<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>ArgoCD GitOps Demo</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, Segoe UI, Roboto, sans-serif;
      background: ${BG_COLOR};
      color: #ffffff;
    }
    .card {
      text-align: center;
      padding: 2rem 3rem;
      border-radius: 12px;
      background: rgba(0, 0, 0, 0.15);
    }
    h1 { font-size: 2.5rem; margin: 0 0 0.5rem; }
    p { font-size: 1.1rem; opacity: 0.85; margin: 0.25rem 0; }
    .badge {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.3rem 0.8rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.2);
      font-size: 0.9rem;
      letter-spacing: 0.05em;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Hello from ${ENVIRONMENT}</h1>
    <p>Deployed via ArgoCD GitOps</p>
    <div class="badge">version: ${VERSION}</div>
  </div>
</body>
</html>
